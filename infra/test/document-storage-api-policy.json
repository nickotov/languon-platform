{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
            "Resource": ["arn:aws:s3:::languon-document-test"]
        },
        {
            "Effect": "Allow",
            "Action": ["s3:GetObjectVersion", "s3:PutObject"],
            "Resource": ["arn:aws:s3:::languon-document-test/*"]
        }
    ]
}
