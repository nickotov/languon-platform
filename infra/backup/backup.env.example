# Keep the real file root-owned with mode 0600 outside the repository.
PGHOST=postgres-private.example.internal
PGPORT=5432
PGDATABASE=languon
PGUSER=languon_backup
PGPASSWORD=replace-me
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/languon/postgres-ca.crt
BACKUP_SOURCE_ID=data-vps-1
BACKUP_S3_URI=s3://private-backups/languon
BACKUP_S3_ENDPOINT=https://s3.example.invalid
BACKUP_AGE_RECIPIENT=age1replacewithrecipient
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=ru-1

# Restore-only values. Use a separate read-only S3 credential in the real file.
RESTORE_TARGET_DISPOSABLE=true
RESTORE_TARGET_ID=quarterly-drill
RESTORE_PGHOST=restore-postgres.internal
RESTORE_PGPORT=5432
RESTORE_PGDATABASE=languon_restore_a1b2c3d4
RESTORE_PGUSER=languon_restore
RESTORE_PGPASSWORD=replace-me
RESTORE_PGSSLMODE=verify-full
RESTORE_PGSSLROOTCERT=/etc/languon/postgres-ca.crt
BACKUP_AGE_IDENTITY_FILE=/etc/languon/backup-age-identity.txt
