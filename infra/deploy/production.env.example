# Copy to /etc/languon/production.env with owner root and mode 0600.
ADMIN_BASE_URL=https://admin.example.invalid
ADMIN_HTPASSWD_PATH=/etc/languon/admin.htpasswd
AUTH_ALLOWED_ORIGINS=https://example.invalid,https://admin.example.invalid
AUTH_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_SECRET=replace-with-a-different-32-character-secret
AUTH_WEBAUTHN_RP_ID=example.invalid
DATABASE_URL=postgres://languon_app:replace@data.internal:5432/languon?sslmode=verify-full
MIGRATION_DATABASE_URL=postgres://languon_migrator:replace@data.internal:5432/languon?sslmode=verify-full
REDIS_URL=rediss://languon_app:replace@data.internal:6379/0
DATA_TLS_CA_PATH=/etc/languon/data-ca.crt
DATABASE_MAX_CONNECTIONS=10
EDGE_SUBNET=172.30.20.0/24
BACKUP_MANIFEST_PATH=/var/lib/languon/backups/latest-production.json
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_BASE_URL=https://example.invalid
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8444
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/example.invalid/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/example.invalid/privkey.pem
