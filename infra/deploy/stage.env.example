# Copy to /etc/languon/stage.env with owner root and mode 0600.
ADMIN_BASE_URL=https://admin.stage.example.invalid
ADMIN_HTPASSWD_PATH=/etc/languon/admin.htpasswd
AUTH_ALLOWED_ORIGINS=https://stage.example.invalid,https://admin.stage.example.invalid
AUTH_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_SECRET=replace-with-a-different-32-character-secret
DICTIONARY_HMAC_SECRET=replace-with-a-third-dedicated-32-character-secret
AUTH_WEBAUTHN_RP_ID=stage.example.invalid
DATABASE_URL=postgres://languon_app:replace@stage-postgres:5432/languon
DICTIONARY_WORKER_DATABASE_URL=postgres://languon_dictionary_worker:replace@stage-postgres:5432/languon
ACCOUNT_PURGE_DATABASE_URL=postgres://languon_account_purge:replace@stage-postgres:5432/languon
MIGRATION_DATABASE_URL=postgres://languon_migrator:replace@stage-postgres:5432/languon
REDIS_URL=redis://:replace@stage-redis:6379/0
DATABASE_MAX_CONNECTIONS=10
DICTIONARY_WORKER_DATABASE_MAX_CONNECTIONS=4
DICTIONARY_WORKER_CONCURRENCY=2
DICTIONARY_WORKER_POLL_INTERVAL_MS=1000
DICTIONARY_WORKER_READINESS_TIMEOUT_MS=5000
DICTIONARY_WORKER_DRAIN_TIMEOUT_MS=295000
ACCOUNT_PURGE_DATABASE_MAX_CONNECTIONS=2
ACCOUNT_PURGE_POLL_INTERVAL_MS=5000
DICTIONARY_DOCUMENT_OCR_MODE=unavailable
DICTIONARY_DOCUMENT_RUNTIME_MODE=unavailable
DICTIONARY_DOCUMENT_STORAGE_MODE=unavailable
# DICTIONARY_DOCUMENT_FINGERPRINT_HMAC_SECRET=replace-with-a-dedicated-32-byte-secret
# Keep unavailable until storage conformance, scanner freshness, sandbox escape,
# and document-format overlap gates pass. Use separate API/worker credentials.
# DICTIONARY_DOCUMENT_STORAGE_ENDPOINT=https://document-storage.stage.example.invalid
# DICTIONARY_DOCUMENT_STORAGE_REGION=replace
# DICTIONARY_DOCUMENT_STORAGE_BUCKET=replace
# DICTIONARY_DOCUMENT_STORAGE_FORCE_PATH_STYLE=false
# DICTIONARY_DOCUMENT_STORAGE_API_ACCESS_KEY_ID=replace
# DICTIONARY_DOCUMENT_STORAGE_API_SECRET_ACCESS_KEY=replace
# DICTIONARY_DOCUMENT_STORAGE_WORKER_ACCESS_KEY_ID=replace
# DICTIONARY_DOCUMENT_STORAGE_WORKER_SECRET_ACCESS_KEY=replace
# ACCOUNT_PURGE_STORAGE_ACCESS_KEY_ID=replace
# ACCOUNT_PURGE_STORAGE_SECRET_ACCESS_KEY=replace
# Use a separate immutable/versioned retained bucket, never the document bucket.
# Replace every value below and initialize the sentinel before first activation.
ACCOUNT_DELETION_JOURNAL_BUCKET=replace-journal-bucket
ACCOUNT_DELETION_JOURNAL_PREFIX=deletion-v1
ACCOUNT_DELETION_JOURNAL_NAMESPACE=stage
ACCOUNT_DELETION_JOURNAL_REGION=replace-region
ACCOUNT_DELETION_JOURNAL_ENCRYPTION_KEY_BASE64=replace-with-base64-32-random-bytes
ACCOUNT_DELETION_JOURNAL_WRITER_ACCESS_KEY_ID=replace-writer-key
ACCOUNT_DELETION_JOURNAL_WRITER_SECRET_ACCESS_KEY=replace-writer-secret
ACCOUNT_DELETION_JOURNAL_READER_ACCESS_KEY_ID=replace-reader-key
ACCOUNT_DELETION_JOURNAL_READER_SECRET_ACCESS_KEY=replace-reader-secret
# ACCOUNT_DELETION_JOURNAL_ENDPOINT=https://journal.stage.example.invalid
# ACCOUNT_DELETION_JOURNAL_FORCE_PATH_STYLE=false
# DICTIONARY_DOCUMENT_SCANNER_HOST=document-scanner
# DICTIONARY_DOCUMENT_SCANNER_PORT=3310
# DICTIONARY_DOCUMENT_SANDBOX_APPLICATION_ROOT=/app
# DICTIONARY_DOCUMENT_SANDBOX_BWRAP_PATH=/usr/bin/bwrap
# DICTIONARY_DOCUMENT_SANDBOX_PARSER_ENTRY_PATH=/app/dist/infrastructure/worker/dictionary-document-parser-command.js
DICTIONARY_GENERATION_PROVIDER_MODE=unavailable
# The aggregate envelope fits five bounded 20-row pasted-term chunks.
DICTIONARY_GENERATION_MAX_INPUT_TOKENS=262144
DICTIONARY_GENERATION_MAX_OUTPUT_TOKENS=40960
DICTIONARY_GENERATION_INPUT_COST_MICROS_PER_MILLION_TOKENS=1000000
DICTIONARY_GENERATION_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=4000000
DICTIONARY_GENERATION_MAX_COST_MICROS_PER_ATTEMPT=500000
# Set all three only when switching mode to mastra; keep the key secret.
# DICTIONARY_GENERATION_MODEL_ID=provider/model-v1
# DICTIONARY_GENERATION_MODEL_BASE_URL=https://models.example.invalid/v1
# DICTIONARY_GENERATION_MODEL_API_KEY=
EDGE_SUBNET=172.30.10.0/24
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_BASE_URL=https://stage.example.invalid
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8444
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/stage.example.invalid/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/stage.example.invalid/privkey.pem
