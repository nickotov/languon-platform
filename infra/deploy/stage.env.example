# Copy to /etc/languon/stage.env with owner root and mode 0600.
ADMIN_BASE_URL=https://admin.stage.example.invalid
ADMIN_HTPASSWD_PATH=/etc/languon/admin.htpasswd
AUTH_ALLOWED_ORIGINS=https://stage.example.invalid,https://admin.stage.example.invalid
AUTH_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_SECRET=replace-with-a-different-32-character-secret
AUTH_WEBAUTHN_RP_ID=stage.example.invalid
DATABASE_URL=postgres://languon_app:replace@stage-postgres:5432/languon
MIGRATION_DATABASE_URL=postgres://languon_migrator:replace@stage-postgres:5432/languon
REDIS_URL=redis://:replace@stage-redis:6379/0
DATABASE_MAX_CONNECTIONS=10
EDGE_SUBNET=172.30.10.0/24
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_BASE_URL=https://stage.example.invalid
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8444
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/stage.example.invalid/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/stage.example.invalid/privkey.pem
