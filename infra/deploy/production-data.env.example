# Copy to /etc/languon/production-data.env with owner root and mode 0600.
POSTGRES_DB=languon
POSTGRES_PASSWORD=replace-bootstrap-password-and-use-role-specific-credentials
POSTGRES_USER=languon_admin
DATA_PRIVATE_ADDRESS=10.0.0.10
POSTGRES_HBA_PATH=/etc/languon/postgresql.production.pg_hba.conf
DATA_TLS_CA_PATH=/etc/languon/data-ca.crt
POSTGRES_TLS_CERTIFICATE_PATH=/etc/languon/postgres-server.crt
POSTGRES_TLS_PRIVATE_KEY_PATH=/etc/languon/postgres-server.key
REDIS_TLS_CERTIFICATE_PATH=/etc/languon/redis-server.crt
REDIS_TLS_PRIVATE_KEY_PATH=/etc/languon/redis-server.key
REDIS_ACL_PATH=/etc/languon/redis.production.acl
REDIS_HEALTH_USER=languon_health
REDIS_HEALTH_PASSWORD=replace-with-a-health-only-password
