{
    "name": "languon",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@10.13.1",
    "engines": {
        "node": ">=24 <25",
        "pnpm": ">=10"
    },
    "scripts": {
        "agent": "headroom wrap codex",
        "admin:audit:prune": "pnpm --filter @languon/backend admin:membership -- prune",
        "admin:membership": "pnpm --filter @languon/backend admin:membership",
        "admin:membership:stdin": "pnpm --filter @languon/backend admin:membership -- --request-stdin",
        "admin:membership:remote": "node scripts/admin-membership-remote.mjs",
        "agent-skills:check": "node --test scripts/check-agent-skills.test.mjs && node scripts/check-agent-skills.mjs",
        "browser": "node scripts/agent-browser.mjs",
        "browser:check": "node --test scripts/agent-browser.test.mjs scripts/agent-browser.integration.test.mjs && node scripts/agent-browser.mjs --doctor",
        "browser:install": "node scripts/agent-browser.mjs --install",
        "build": "turbo run build",
        "check": "pnpm check:setup-docs && pnpm format:check && pnpm agent-skills:check && pnpm styles:check && pnpm web-dev-panel:check && pnpm docs:user-flows:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "db:check": "pnpm --filter @languon/backend db:check",
        "db:generate": "pnpm --filter @languon/backend db:generate",
        "db:migrate": "pnpm --filter @languon/backend db:migrate",
        "db:studio": "pnpm --filter @languon/backend db:studio",
        "dev": "turbo run dev --parallel --filter=!@languon/mobile --filter=!@languon/web-dev-panel",
        "dev:all": "node scripts/dev-all.mjs",
        "dev:admin": "turbo run dev --filter=@languon/admin",
        "dev:admin:docker": "turbo run dev:docker --filter=@languon/admin",
        "dev:apps:docker": "docker compose --profile apps up --build backend web admin",
        "dev:backend": "turbo run dev --filter=@languon/backend",
        "dev:dictionary-worker": "pnpm --filter @languon/backend dictionary:worker",
        "dev:account-purge-worker": "pnpm --filter @languon/backend account:purge:worker",
        "dev:infra": "docker compose up -d postgres redis minio minio-init",
        "dev:mastra": "turbo run dev:mastra --filter=@languon/backend",
        "dev:mobile": "turbo run dev --filter=@languon/mobile",
        "dev:mobile:docker": "turbo run dev:docker --filter=@languon/mobile",
        "dev:panel": "pnpm --filter @languon/web-dev-panel dev",
        "dev:web": "turbo run dev --filter=@languon/web",
        "dev:web:docker": "turbo run dev:docker --filter=@languon/web",
        "deploy:local": "node infra/deploy/local-rehearsal.mjs journey",
        "deploy:local:verify": "node infra/deploy/local-rehearsal.mjs verify",
        "deploy:local:rollback": "node infra/deploy/local-rehearsal.mjs rollback",
        "deploy:local:down": "node infra/deploy/local-rehearsal.mjs down",
        "deploy:remote": "node scripts/deploy-remote.mjs",
        "docs:user-flows:check": "node --test scripts/check-user-flow-guides.test.mjs && node scripts/check-user-flow-guides.mjs",
        "feature:new": "node scripts/create-feature.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "infra:down": "docker compose down",
        "mastra:playground:reset": "pnpm --filter @languon/backend mastra:playground:reset",
        "lint": "eslint .",
        "resources:dashboard": "node scripts/resources/dashboard.mjs",
        "resources:profile": "node scripts/resources/profile.mjs",
        "test": "pnpm test:critical-tooling && pnpm test:diagrams && pnpm test:code-search && node --test scripts/create-feature.test.mjs && pnpm test:agent-browser && pnpm test:document-services && pnpm test:frontend-architecture && pnpm test:persistence-readability && pnpm test:mastra-harness && pnpm test:release-deployment && turbo run test",
        "test:agent-browser": "node --test scripts/agent-browser.test.mjs",
        "test:document-services": "node --test infra/test/document-services.test.mjs",
        "test:e2e:admin-user-management": "node scripts/run-admin-user-management-e2e.mjs",
        "test:e2e:ai-provider-management": "pnpm --filter @languon/admin exec playwright test tests/e2e/admin-user-management.journeys.spec.ts --grep \"owner publishes routing tariffs\"",
        "test:e2e:ai-credit-wallet": "pnpm turbo run build --filter=@languon/contracts --filter=@languon/database --filter=@languon/languages --filter=@languon/prompts && DICTIONARY_AI_CREDIT_ENFORCEMENT_ENABLED=true pnpm --filter @languon/admin exec playwright test tests/e2e/admin-user-management.journeys.spec.ts --grep \"owner grants AI credits\"",
        "test:frontend-architecture": "node --test scripts/eslint-fsd-boundaries.test.mjs",
        "test:persistence-readability": "node --test scripts/eslint-persistence-readability.test.mjs",
        "test:mastra-harness": "node --test scripts/dev-mastra.test.mjs",
        "test:release-deployment": "node --test infra/backup/backup.test.mjs infra/deploy/tests/*.test.mjs scripts/migration-classification.test.mjs scripts/release-manifest.test.mjs scripts/release-workflow-contract.test.mjs scripts/resources/resources.test.mjs",
        "test:e2e:web-dev-panel": "pnpm --filter @languon/web-dev-panel test:e2e",
        "test:web-dev-panel": "pnpm --filter @languon/web-dev-panel test",
        "test:coverage": "turbo run test:coverage",
        "typecheck": "turbo run typecheck",
        "user-flow:e2e": "node scripts/user-flow-e2e.mjs",
        "user-flow:e2e:check": "node scripts/user-flow-e2e.mjs check",
        "web-dev-panel:check": "pnpm --filter @languon/web-dev-panel catalog:check",
        "test:e2e:user-ai-model-preferences-backend": "node scripts/run-user-ai-model-preferences-e2e.mjs",
        "test:e2e:sentence-practice-backend": "node scripts/run-sentence-practice-e2e.mjs",
        "test:e2e:learner-portrait": "node scripts/run-learner-portrait-e2e.mjs",
        "search:ast": "ast-grep",
        "test:code-search": "node --test scripts/code-search.test.mjs",
        "styles:check": "pnpm --filter @languon/web styles:check",
        "test:e2e:shared-pronunciation": "node scripts/run-shared-pronunciation-e2e.mjs",
        "test:e2e:texts-backend": "node scripts/run-texts-e2e.mjs",
        "test:e2e:texts-web": "node scripts/run-texts-web-e2e.mjs",
        "test:e2e:texts": "node scripts/run-texts-all-e2e.mjs",
        "test:e2e:contextual-assistant": "node scripts/run-contextual-assistant-e2e.mjs",
        "diagrams": "node scripts/architecture-viewer/server.mjs",
        "diagrams:check": "node scripts/architecture-viewer/check.mjs",
        "test:diagrams": "node --test scripts/architecture-viewer/test/*.test.mjs",
        "test:e2e:diagrams": "playwright test --config scripts/architecture-viewer/playwright.config.mjs",
        "dev:doctor": "node scripts/dev-doctor.mjs",
        "dev:configure": "node scripts/dev-configure.mjs",
        "test:e2e:critical": "node scripts/run-critical-flows.mjs",
        "test:critical-tooling": "pnpm exec turbo run build --filter=@languon/contracts && node --test scripts/dev-all.test.mjs scripts/dev-readiness/*.test.mjs scripts/dev-setup/*.test.mjs scripts/critical-flows/*.test.mjs",
        "check:setup-docs": "node scripts/dev-configure.mjs --check-docs docs/operations/local-testing-setup.md",
        "critical-flows:check": "node scripts/check-critical-flows.mjs",
        "dev:admin-mcp": "pnpm --filter @languon/backend admin:mcp"
    },
    "devDependencies": {
        "@ast-grep/cli": "0.45.3",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitest/coverage-v8": "^4.1.10",
        "agent-browser": "0.33.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^7.2.0",
        "globals": "^17.9.0",
        "jsdom": "^30.0.1",
        "mermaid": "^12.2.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "tsx": "^4.23.12",
        "turbo": "^2.10.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10",
        "zod": "^4.4.3"
    }
}
