NODE_ENV=development
APP_ENV=development
BACKEND_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=languon
POSTGRES_USER=languon
POSTGRES_PASSWORD=languon-local
DATABASE_URL=postgres://languon:languon-local@localhost:5432/languon

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication defaults below are for local development only. Replace both
# secrets with independent high-entropy values in every deployed environment.
AUTH_JWT_SECRET=development-only-jwt-secret-change-me-9f87c82b4d31
AUTH_CODE_HMAC_SECRET=development-only-code-secret-change-me-36a29d70c54e
AUTH_JWT_ISSUER=languon
AUTH_JWT_AUDIENCE=languon-api
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_RP_NAME=Languon
AUTH_TRUST_PROXY=false
# Required when AUTH_TRUST_PROXY=true; list only the reverse proxies that can
# directly connect to the backend (exact IPs and CIDRs, comma-separated).
# AUTH_TRUSTED_PROXY_CIDRS=10.0.0.0/24,2001:db8:1234::/64
AUTH_ACCESS_TOKEN_TTL=2d
AUTH_REFRESH_TOKEN_TTL=14d
AUTH_ARGON2_MEMORY_COST_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
# Private staging only; production rejects this setting even when present.
# AUTH_ALLOW_INSECURE_FIXED_CODE=0000_IS_INSECURE_USE_ONLY_IN_PRIVATE_STAGING

# Configure only when using remote model and observability services.
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
