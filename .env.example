NODE_ENV=development
APP_ENV=development
# Host development listens only on this machine by default.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Vite development proxy used by apps/admin. The browser still calls same-origin
# /api routes so production never embeds a backend host.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:4000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=languon
POSTGRES_USER=languon
POSTGRES_PASSWORD=languon-local
DATABASE_URL=postgres://languon:languon-local@localhost:5432/languon
# Optional in development/test, where the worker falls back to DATABASE_URL.
# Required as a distinct least-privilege credential in staging/production.
DICTIONARY_WORKER_DATABASE_URL=postgres://languon:languon-local@localhost:5432/languon

# Dedicated local Mastra playground. These are never derived from DATABASE_URL.
# The target name prefix and loopback/admin pairing are validated before use.
MASTRA_DEV_HARNESS=true
MASTRA_PLAYGROUND_DATABASE_URL=postgres://languon:languon-local@localhost:5432/languon_mastra_playground
MASTRA_PLAYGROUND_ADMIN_DATABASE_URL=postgres://languon:languon-local@localhost:5432/postgres
MASTRA_PROMPT_MODE=local
MASTRA_MODEL_ID=deepseek/deepseek-chat
# The root harness command forces this value so startup sends no Mastra usage telemetry.
MASTRA_TELEMETRY_DISABLED=true
# Required only for the explicitly destructive playground reset command:
# MASTRA_PLAYGROUND_RESET_CONFIRM=languon_mastra_playground

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Optional bounded namespace for isolating application/test Redis state.
AUTH_REDIS_NAMESPACE=languon:auth:v1

# Authentication and dictionary defaults below are for local development only.
# Replace all three with independent high-entropy values in every deployment.
AUTH_JWT_SECRET=development-only-jwt-secret-change-me-9f87c82b4d31
AUTH_CODE_HMAC_SECRET=development-only-code-secret-change-me-36a29d70c54e
DICTIONARY_HMAC_SECRET=development-only-dictionary-secret-change-me-c9741f0e52ab
AUTH_JWT_ISSUER=languon
AUTH_JWT_AUDIENCE=languon-api
AUTH_ALLOWED_ORIGINS=http://localhost:3333,http://localhost:3001
ADMIN_BASE_URL=http://localhost:3001
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_RP_NAME=Languon
AUTH_TRUST_PROXY=false
# Required when AUTH_TRUST_PROXY=true; list only the reverse proxies that can
# directly connect to the backend (exact IPs and CIDRs, comma-separated).
# AUTH_TRUSTED_PROXY_CIDRS=10.0.0.0/24,2001:db8:1234::/64
AUTH_ACCESS_TOKEN_TTL=2d
AUTH_REFRESH_TOKEN_TTL=14d
AUTH_ARGON2_MEMORY_COST_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
# Private staging only; production rejects this setting even when present.
# AUTH_ALLOW_INSECURE_FIXED_CODE=0000_IS_INSECURE_USE_ONLY_IN_PRIVATE_STAGING

# Required only for live Mastra agent execution; deterministic harness checks do not use it.
DEEPSEEK_API_KEY=
# Add the provider-specific key when MASTRA_MODEL_ID selects an alternate primary.
# OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Dictionary generation ships fail-closed with every lifecycle set empty. A
# reviewed live-provider expand may add lifecycle support while leaving enqueue
# empty; activate a format only after its rollback-floor compatibility gate.
DICTIONARY_JOB_API_READABLE_FORMATS=
DICTIONARY_JOB_API_CANCELLABLE_FORMATS=
DICTIONARY_JOB_API_DISCARDABLE_FORMATS=
DICTIONARY_JOB_API_ACCEPTABLE_FORMATS=
DICTIONARY_JOB_API_ENQUEUED_FORMATS=
DICTIONARY_JOB_WORKER_PROCESSABLE_FORMATS=
DICTIONARY_DOCUMENT_OCR_MODE=unavailable
DICTIONARY_DOCUMENT_RUNTIME_MODE=unavailable
DICTIONARY_DOCUMENT_STORAGE_MODE=unavailable
# DICTIONARY_DOCUMENT_FINGERPRINT_HMAC_SECRET=
# Document ingestion remains unavailable until the private product-storage,
# scanner and production sandbox gates pass. API and worker credentials must be
# distinct and must never reuse backup credentials.
# DICTIONARY_DOCUMENT_STORAGE_ENDPOINT=http://127.0.0.1:59000
# DICTIONARY_DOCUMENT_STORAGE_REGION=us-east-1
# DICTIONARY_DOCUMENT_STORAGE_BUCKET=languon-document-local
# DICTIONARY_DOCUMENT_STORAGE_FORCE_PATH_STYLE=true
# DICTIONARY_DOCUMENT_STORAGE_API_ACCESS_KEY_ID=
# DICTIONARY_DOCUMENT_STORAGE_API_SECRET_ACCESS_KEY=
# DICTIONARY_DOCUMENT_STORAGE_WORKER_ACCESS_KEY_ID=
# DICTIONARY_DOCUMENT_STORAGE_WORKER_SECRET_ACCESS_KEY=
# DICTIONARY_DOCUMENT_SCANNER_HOST=127.0.0.1
# DICTIONARY_DOCUMENT_SCANNER_PORT=53310
# DICTIONARY_DOCUMENT_SANDBOX_APPLICATION_ROOT=/app
# DICTIONARY_DOCUMENT_SANDBOX_BWRAP_PATH=/usr/bin/bwrap
# DICTIONARY_DOCUMENT_SANDBOX_PARSER_ENTRY_PATH=/app/dist/infrastructure/worker/dictionary-document-parser-command.js
DICTIONARY_GENERATION_PROVIDER_MODE=unavailable
# The aggregate envelope fits five bounded 20-row pasted-term chunks.
DICTIONARY_GENERATION_MAX_INPUT_TOKENS=262144
DICTIONARY_GENERATION_MAX_OUTPUT_TOKENS=40960
DICTIONARY_GENERATION_INPUT_COST_MICROS_PER_MILLION_TOKENS=1000000
DICTIONARY_GENERATION_OUTPUT_COST_MICROS_PER_MILLION_TOKENS=4000000
DICTIONARY_GENERATION_MAX_COST_MICROS_PER_ATTEMPT=500000
# Live worker-only example; leave unset while unavailable. Never commit the key.
# DICTIONARY_GENERATION_MODEL_ID=provider/model-v1
# DICTIONARY_GENERATION_MODEL_BASE_URL=https://models.example.invalid/v1
# DICTIONARY_GENERATION_MODEL_API_KEY=
