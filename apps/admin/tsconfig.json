{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["vite/client", "vitest/globals"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "vite.config.ts",
        "playwright.config.ts"
    ]
}
